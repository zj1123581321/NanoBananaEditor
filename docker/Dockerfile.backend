# Nano Banana AI Image Editor - 后端 Dockerfile
# Node.js 图片服务器 + API

FROM node:18-alpine

# 安装系统依赖
RUN apk add --no-cache \
    curl \
    dumb-init

# 创建应用用户
RUN addgroup -g 1001 -S appuser && \
    adduser -S appuser -u 1001 -G appuser

# 设置工作目录
WORKDIR /app

# 复制 package 文件
COPY package*.json ./

# 安装依赖
RUN npm ci --only=production && \
    npm cache clean --force

# 复制应用代码
COPY server/ ./server/
COPY generated_images/ ./generated_images/

# 创建必要目录
RUN mkdir -p logs generated_images

# 设置权限
RUN chown -R appuser:appuser /app

# 切换到非 root 用户
USER appuser

# 暴露端口
EXPOSE 3002

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3002/health || exit 1

# 设置环境变量
ENV NODE_ENV=production
ENV IMAGE_SERVER_PORT=3002
ENV IMAGE_SERVER_HOST=0.0.0.0

# 使用 dumb-init 启动应用
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server/imageServerExtended.cjs"]