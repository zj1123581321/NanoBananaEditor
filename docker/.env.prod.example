# ============================================
# 生产环境配置 (Docker 目录使用)
# 使用方法: 复制为 .env.prod 并填入实际值
# ============================================

# === 应用模式 ===
VITE_APP_MODE=multi-user
NODE_ENV=production

# === 服务端口 ===
APP_PORT=3002
IMAGE_SERVER_PORT=3002
IMAGE_SERVER_HOST=0.0.0.0

# === Gemini API ===
VITE_GEMINI_API_KEY=your-gemini-api-key

# === OpenAI API (Prompt 优化) ===
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# === 图片服务器 ===
# 生产环境请修改为实际服务器地址
VITE_IMAGE_SERVER_URL=http://your-server-ip:3002

# === 企微通知 ===
VITE_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# === Supabase ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === CORS ===
CORS_ORIGIN=*

# === 管理员 ===
ADMIN_USERNAME=admin
# 生产环境务必修改默认密码！
# 重要: 必须使用单引号包裹哈希值，否则 $ 会被解析为变量导致 401 错误
ADMIN_PASSWORD_HASH='$2a$10$9vPKr5ZHB9.Z6PRweqDMCOPG5LXhmK.FuRAXjVp7be.0IYQUiHzAm'

# === Nginx (可选) ===
NGINX_PORT=80
NGINX_HTTPS_PORT=443
