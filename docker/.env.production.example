# ============================================
# 生产环境配置模板
# 使用方法: 复制为 .env.production 并填入实际值
# ============================================

# === 应用模式配置 ===
VITE_APP_MODE=multi-user
NODE_ENV=production

# === 服务端口配置 ===
APP_PORT=3002
IMAGE_SERVER_PORT=3002
IMAGE_SERVER_HOST=0.0.0.0

# === Gemini API 配置 ===
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# === OpenAI API 配置 (用于 Prompt 优化和文本 AI 处理任务) ===
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# === 图片服务器配置 ===
# 注意：生产环境请修改为实际的服务器地址
VITE_IMAGE_SERVER_URL=http://your-server-domain:3002

# === 企微通知配置 ===
VITE_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_WEBHOOK_KEY_HERE

# === 多用户模式配置 ===
# Supabase 项目 URL (前后端共用)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 前端使用匿名密钥 (公开安全)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 后端使用服务角色密钥 (服务器端安全)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# === Docker 部署配置 ===
FRONTEND_PORT=3000
ADMIN_PORT=3003

# === CORS 跨域配置 ===
# 方式1：允许所有源（简单但安全性较低）
CORS_ORIGIN=*

# 方式2：指定具体的服务器地址（推荐）
# 将 your-server-ip 替换为实际的服务器IP地址
# CORS_ADDITIONAL_ORIGINS=http://your-server-ip:3002,https://your-domain.com

# === 管理员配置 ===
ADMIN_USERNAME=admin
# 使用 bcrypt 生成密码哈希，或使用默认密码 "admin123"
ADMIN_PASSWORD_HASH=$2a$10$9vPKr5ZHB9.Z6PRweqDMCOPG5LXhmK.FuRAXjVp7be.0IYQUiHzAm

# === 可选的 Nginx 配置 ===
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# 重要提醒：
# 1. 请将所有 "your-*-here" 替换为实际值
# 2. 生产环境务必修改默认管理员密码
# 3. VITE_IMAGE_SERVER_URL 需要设置为服务器的实际地址
# ============================================