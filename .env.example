# Gemini API Configuration
VITE_GEMINI_API_KEY=

# OpenAI API Configuration (用于 Prompt 优化和文本 AI 处理任务)
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# Image Server Configuration
VITE_IMAGE_SERVER_URL=http://localhost:3002
IMAGE_SERVER_PORT=3002
IMAGE_SERVER_HOST=0.0.0.0

# WeChat Work Notification Configuration
VITE_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_WEBHOOK_KEY_HERE
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_WEBHOOK_KEY_HERE

