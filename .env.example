# === 应用模式配置 ===
VITE_APP_MODE=standalone
# 可选值: standalone (单用户模式) 或 multi-user (多用户模式)

# === Gemini API 配置 ===
VITE_GEMINI_API_KEY=

# === OpenAI API 配置 (用于 Prompt 优化和文本 AI 处理任务) ===
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# === 图片服务器配置 ===
VITE_IMAGE_SERVER_URL=http://localhost:3002
IMAGE_SERVER_PORT=3002
IMAGE_SERVER_HOST=0.0.0.0

# === 企微通知配置 ===
VITE_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_WEBHOOK_KEY_HERE

# === 多用户模式配置 (仅在 VITE_APP_MODE=multi-user 时使用) ===
# Supabase 项目 URL (前后端共用)
VITE_SUPABASE_URL=

# 前端使用匿名密钥 (公开安全)
VITE_SUPABASE_ANON_KEY=

# 后端使用服务角色密钥 (服务器端安全)
SUPABASE_SERVICE_ROLE_KEY=

# === Docker 部署配置 ===
FRONTEND_PORT=3000
ADMIN_PORT=3003
CORS_ORIGIN=http://localhost:3000

# === 管理员配置 ===
ADMIN_USERNAME=admin
# 重要: Linux/Unix 服务器必须使用单引号包裹哈希值，否则 $ 会被解析为变量
ADMIN_PASSWORD_HASH='$2a$10$9vPKr5ZHB9.Z6PRweqDMCOPG5LXhmK.FuRAXjVp7be.0IYQUiHzAm'

# 注意: 生产环境中，API 调用应通过后端代理进行
# 此配置仅用于开发和演示目的
