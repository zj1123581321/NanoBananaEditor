# ============================================
# Docker 构建忽略文件
# 目的：减少构建上下文大小，加快构建速度
# ============================================

# === 版本控制 ===
.git/
.gitignore
.gitattributes

# === 依赖目录 ===
node_modules/
admin/node_modules/

# === 构建产物（由 Docker 内部构建） ===
dist/
admin/dist/
build/

# === 开发工具和缓存 ===
.npm
.yarn
.pnpm-store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === 测试和覆盖率 ===
tests/
coverage/
.nyc_output/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# === IDE 和编辑器 ===
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# === 操作系统文件 ===
.DS_Store
Thumbs.db
Desktop.ini

# === 文档 ===
docs/
*.md
!README.md
LICENSE

# === Docker 相关（避免递归） ===
docker/output/
docker/*.tar
Dockerfile*
docker-compose*.yml
.dockerignore

# === 临时文件 ===
tmp/
temp/
.tmp/
*.log
logs/

# === 运行时数据（通过 volume 挂载） ===
generated_images/
uploads/

# === 环境配置（保留 .env 用于构建时 Vite 变量） ===
.env.local
.env.*.local
.env.dev.example
.env.prod.example

# === 脚本目录 ===
scripts/

# === Supabase 本地配置 ===
supabase/.temp/
