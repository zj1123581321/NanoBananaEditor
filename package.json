{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:unified",
    "dev:unified": "npm run cleanup && concurrently --kill-others-on-fail --prefix \"[{name}]\" --prefix-colors \"cyan,magenta,yellow\" --names \"frontend,backend,admin\" \"vite\" \"set VITE_APP_MODE=multi-user&& node server/imageServerExtended.cjs\" \"cd admin && npm run dev\"",
    "dev:standalone": "npm run cleanup && concurrently --kill-others-on-fail --prefix \"[{name}]\" --prefix-colors \"cyan,magenta\" --names \"frontend,backend\" \"vite\" \"set VITE_APP_MODE=standalone&& node server/imageServer.cjs\"",
    "dev:frontend": "vite",
    "dev:backend": "set VITE_APP_MODE=multi-user&& node server/imageServerExtended.cjs",
    "dev:admin": "cd admin && npm run dev",
    "cleanup": "node scripts/cleanup-safe.cjs",
    "build": "vite build",
    "build:admin": "cd admin && npm run build",
    "build:all": "npm run build && npm run build:admin",
    "lint": "eslint .",
    "lint:admin": "cd admin && npm run lint",
    "lint:all": "npm run lint && npm run lint:admin",
    "preview": "vite preview",
    "preview:admin": "cd admin && npm run preview",
    "start": "npm run start:unified",
    "start:unified": "npm run cleanup && npm run build:all && set VITE_APP_MODE=multi-user&& node server/imageServerExtended.cjs",
    "start:standalone": "npm run cleanup && npm run build && set VITE_APP_MODE=standalone&& node server/imageServer.cjs",
    "test:notification": "node tests/test-notification.cjs",
    "test:notification:cleanup": "node tests/test-notification.cjs --cleanup",
    "test:real-image": "node tests/test-real-image.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/supabase-js": "^2.39.3",
    "@tanstack/react-query": "^5.85.5",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "fabric": "^6.7.1",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "idb-keyval": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "konva": "^9.3.22",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.3",
    "react-konva": "^18.2.10",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
