# Docker 环境变量配置
VITE_APP_MODE=multi-user
APP_PORT=3002
NODE_ENV=production

# 后端 API 密钥（多用户模式）
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here  
GOOGLE_API_KEY=your-google-key-here

# 前端 API 密钥（单用户模式，构建时需要）
VITE_OPENAI_API_KEY=your-openai-key-here
VITE_GEMINI_API_KEY=your-google-key-here
VITE_ANTHROPIC_API_KEY=your-anthropic-key-here

# 管理员账户
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$example-hash-here

# 服务器配置
IMAGE_SERVER_PORT=3002
IMAGE_SERVER_HOST=0.0.0.0

# 多用户模式 - Supabase 配置（构建期前端必需，运行期后端也会使用）
# 请替换为你的实际值；若项目根目录存在 .env，则会优先生效
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_IMAGE_SERVER_URL=http://localhost:3002
